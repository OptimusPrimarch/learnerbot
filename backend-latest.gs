// ============================================================
// LearnerBot loader
//
// This small piece almost never changes. The app itself is the function _lbBuiltin() at the very
// bottom of this file: the version that came with this copy of the sheet.
//
// "Update now" in the LearnerBot site can install a newer copy of the app into this script's private
// properties, and the loader then runs whichever copy is newer. If an installed copy will not even
// start, the built-in copy runs instead, so an update can never leave the sheet without a working app.
//
// Generated by tools/build-bundle.js from tools/loader.js and backend/*.js. Do not edit here.
// ============================================================

// The one place an update is ever downloaded from. It is a constant on purpose: nothing a caller
// sends can change it.
const LB_UPDATE_URL = 'https://optimusprimarch.github.io/learnerbot/backend-payload.js';
const LB_BUILTIN_VERSION = '2026.10.11';
const LB_ENTRIES = ["doGet","doPost","onOpen","menuSetGroqKey","menuShowConnection","menuResetToken","menuEmailsOff","_dailyJob","_weeklyJob","_nudgeJob"];
const LB_CHUNK = 7000;            // characters per property (a property holds about 9 KB; the app text is plain ASCII)
const LB_MIN_SIZE = 20000;        // a real app is never smaller than this...
const LB_MAX_SIZE = 400000;       // ...or larger than this
const LB_UPDATES_PER_HOUR = 6;

let _lbRun = null;                // the app for this run
let _lbLoadError = '';
let _lbSeen = { installed: '', rollbackTo: '' };

// ---- picking which copy of the app runs ------------------------

function _lbVer(a, b) {
  const pa = String(a || '0').split('.').map(Number), pb = String(b || '0').split('.').map(Number);
  for (let i = 0; i < Math.max(pa.length, pb.length); i++) {
    const d = (pa[i] || 0) - (pb[i] || 0);
    if (d) return d < 0 ? -1 : 1;
  }
  return 0;
}

function _lbProps() { return PropertiesService.getScriptProperties(); }

function _lbMeta(raw) {
  try { const m = JSON.parse(raw); return m && typeof m === 'object' ? m : {}; } catch (_) { return {}; }
}

/** One stored copy of the app, put back together from its chunks, or null if any piece is missing. */
function _lbSlot(all, meta, name) {
  const s = meta[name];
  if (!s || !s.chunks) return null;
  let code = '';
  for (let i = 0; i < s.chunks; i++) {
    const part = all['LB_' + name + '_' + i];
    if (typeof part !== 'string') return null;
    code += part;
  }
  return code.length === s.size ? { version: s.version, code: code } : null;
}

/** Turns app text into the app. Throws if it is not a complete LearnerBot app. */
function _lbLoad(code) {
  const app = new Function(code)();
  LB_ENTRIES.forEach(function (name) {
    if (typeof app[name] !== 'function') throw new Error('it has no ' + name);
  });
  if (typeof app.version !== 'string') throw new Error('it has no version');
  return app;
}

function _lbRuntime() {
  if (_lbRun) return _lbRun;
  try {
    const props = _lbProps();
    const raw = props.getProperty('LB_META');
    if (raw) {
      const all = props.getProperties();
      const meta = _lbMeta(raw);
      const other = meta.active === 'A' ? 'B' : 'A';
      const slot = meta.active ? _lbSlot(all, meta, meta.active) : null;
      const prev = meta.active ? _lbSlot(all, meta, other) : null;
      // Going back only ever goes backwards: to an older installed copy if there is one, otherwise to the built-in app.
      const older = slot && prev && _lbVer(prev.version, slot.version) < 0 && _lbVer(prev.version, LB_BUILTIN_VERSION) > 0;
      _lbSeen = { installed: slot ? slot.version : '', rollbackTo: older ? prev.version : LB_BUILTIN_VERSION };
      if (meta.active && !slot) _lbLoadError = 'The installed update is damaged, so the built-in version is running.';
      if (slot && _lbVer(slot.version, LB_BUILTIN_VERSION) > 0) {
        try {
          _lbRun = _lbLoad(slot.code);
          _lbRun.source = 'installed';
          return _lbRun;
        } catch (e) {
          _lbLoadError = 'The installed update (' + slot.version + ') would not start (' + e.message + '), so the built-in version is running.';
          Logger.log(_lbLoadError);
        }
      }
    }
  } catch (e) {
    Logger.log('Loader could not read installed updates: ' + e);
  }
  _lbRun = _lbBuiltin();
  _lbRun.source = 'builtin';
  return _lbRun;
}

/** What the page shows in Settings. Cheap: everything was already read when the app was chosen. */
function lbInfo() {
  const app = _lbRuntime();
  return {
    source: app.source,
    version: app.version,
    builtin: LB_BUILTIN_VERSION,
    installed: _lbSeen.installed,
    rollbackTo: _lbSeen.rollbackTo || LB_BUILTIN_VERSION,
    canRollback: app.source === 'installed',
    loadError: _lbLoadError
  };
}

// ---- entry points Google calls by name -------------------------

function doGet() { return _lbRuntime().doGet.apply(null, arguments); }
function onOpen() { return _lbRuntime().onOpen.apply(null, arguments); }
function menuSetGroqKey() { return _lbRuntime().menuSetGroqKey.apply(null, arguments); }
function menuShowConnection() { return _lbRuntime().menuShowConnection.apply(null, arguments); }
function menuResetToken() { return _lbRuntime().menuResetToken.apply(null, arguments); }
function menuEmailsOff() { return _lbRuntime().menuEmailsOff.apply(null, arguments); }
function _dailyJob() { return _lbRuntime()._dailyJob.apply(null, arguments); }
function _weeklyJob() { return _lbRuntime()._weeklyJob.apply(null, arguments); }
function _nudgeJob() { return _lbRuntime()._nudgeJob.apply(null, arguments); }

function doPost(e) {
  let req = null;
  try { req = JSON.parse((e && e.postData && e.postData.contents) || '{}'); } catch (_) { /* the app answers a malformed body */ }
  if (req && (req.action === 'updateApp' || req.action === 'rollbackApp')) return _lbMetaAction(req);
  return _lbRuntime().doPost(e);
}

// ---- updating and going back -----------------------------------
// These two actions are answered here, not by the app, so a broken installed app can never block them.

function _lbJson(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}

function _lbErr(code, message) {
  const e = new Error(message);
  e.code = code;
  return e;
}

function _lbMetaAction(req) {
  const t0 = Date.now();
  try {
    const master = _lbProps().getProperty('API_TOKEN');
    if (!master) throw _lbErr('not_configured', 'This script is not set up yet. In the sheet, open LearnerBot → Show connection info.');
    // Only the main connection (the access token itself) may change the code; a phone's own token may not.
    if (typeof req.token !== 'string' || req.token !== master) throw _lbErr('forbidden', 'Only your main connection (your computer) can update the script.');
    const cache = CacheService.getScriptCache();
    const n = Number(cache.get('lb_upd') || 0);
    if (n >= LB_UPDATES_PER_HOUR) throw _lbErr('rate_limited', 'Too many update attempts this hour. Try again later.');
    cache.put('lb_upd', String(n + 1), 3600);
    const args = req.args && typeof req.args === 'object' ? req.args : {};
    const data = req.action === 'updateApp' ? lbUpdate(args.expectVersion) : lbRollback();
    return _lbJson({ ok: true, data: data, ms: { total: Date.now() - t0 } });
  } catch (err) {
    return _lbJson({ ok: false, code: (err && err.code) || 'error', error: String((err && err.message) || err), ms: { total: Date.now() - t0 } });
  }
}

function _lbLocked(fn) {
  const lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try { return fn(); } finally { lock.releaseLock(); }
}

/**
 * Downloads the newest app from the LearnerBot site, checks it, and installs it for the next request.
 * Nothing is installed unless the text is a complete, newer LearnerBot app that starts and says the
 * version it claims. `expectVersion` (what the site expects) stops a stale cached copy from being installed.
 */
function lbUpdate(expectVersion) {
  return _lbLocked(function () {
    const running = _lbRuntime().version;
    const url = LB_UPDATE_URL + '?v=' + encodeURIComponent(String(expectVersion || 'latest')).slice(0, 40);
    let resp;
    try { resp = UrlFetchApp.fetch(url, { muteHttpExceptions: true, followRedirects: false }); }
    catch (e) { throw _lbErr('download_failed', 'The update could not be downloaded. Check your connection and try again.'); }
    if (resp.getResponseCode() !== 200) throw _lbErr('download_failed', 'The update could not be downloaded (the site answered ' + resp.getResponseCode() + '). Try again in a minute.');

    const code = resp.getContentText('UTF-8');
    if (code.length < LB_MIN_SIZE || code.length > LB_MAX_SIZE) throw _lbErr('bad_update', 'The downloaded update is not the size of a LearnerBot update, so it was not installed.');
    if (!/^[\x00-\x7f]*$/.test(code)) throw _lbErr('bad_update', 'The downloaded update is not in the expected format, so it was not installed.');
    const header = /^\/\/ LearnerBot app payload (\d{4}\.\d{1,3}\.\d{1,4})\n/.exec(code);
    if (!header) throw _lbErr('bad_update', 'The downloaded file is not a LearnerBot update, so it was not installed.');
    const version = header[1];
    if (expectVersion && version !== String(expectVersion)) throw _lbErr('not_ready', 'The newest version is still being published (the site has ' + version + ', expected ' + expectVersion + '). Wait a minute and try again.');
    if (_lbVer(version, running) <= 0) return { status: 'current', version: running };

    let app;
    try {
      app = _lbLoad(code);
      const hello = JSON.parse(app.doGet().getContent());
      if (app.version !== version || !hello || !hello.ok || !hello.data || hello.data.version !== version) throw new Error('it does not report version ' + version);
    } catch (e) {
      throw _lbErr('bad_update', 'The downloaded update would not start (' + e.message + '), so it was not installed. Nothing changed.');
    }

    _lbInstall(version, code);
    return { status: 'updated', from: running, to: version };
  });
}

/** Writes the new copy into the slot that is not in use, then switches to it in one step. */
function _lbInstall(version, code) {
  const props = _lbProps();
  const meta = _lbMeta(props.getProperty('LB_META'));
  const slot = meta.active === 'A' ? 'B' : 'A';
  const old = meta[slot];
  const chunks = Math.ceil(code.length / LB_CHUNK);
  const values = {};
  for (let i = 0; i < chunks; i++) values['LB_' + slot + '_' + i] = code.slice(i * LB_CHUNK, (i + 1) * LB_CHUNK);
  props.setProperties(values, false);
  if (old && old.chunks > chunks) for (let i = chunks; i < old.chunks; i++) props.deleteProperty('LB_' + slot + '_' + i);
  meta[slot] = { version: version, chunks: chunks, size: code.length };
  meta.active = slot;
  props.setProperty('LB_META', JSON.stringify(meta));   // the switch: until this line, nothing has changed
}

/** Back to an older installed copy, or to the built-in one when there is nothing older (and newer than the built-in) to go back to. */
function lbRollback() {
  return _lbLocked(function () {
    const props = _lbProps();
    const raw = props.getProperty('LB_META');
    const meta = _lbMeta(raw);
    if (!raw || !meta.active) return { status: 'none', version: LB_BUILTIN_VERSION };
    const all = props.getProperties();
    const other = meta.active === 'A' ? 'B' : 'A';
    const cur = _lbSlot(all, meta, meta.active);
    const prev = _lbSlot(all, meta, other);
    if (cur && prev && _lbVer(prev.version, cur.version) < 0 && _lbVer(prev.version, LB_BUILTIN_VERSION) > 0) {
      meta.active = other;
      props.setProperty('LB_META', JSON.stringify(meta));
      return { status: 'rolled_back', to: prev.version };
    }
    _lbClear();
    return { status: 'rolled_back', to: LB_BUILTIN_VERSION, builtin: true };
  });
}

function _lbClear() {
  const props = _lbProps();
  props.getKeys().filter(function (k) { return /^LB_/.test(k); }).forEach(function (k) { props.deleteProperty(k); });
}

/** Sheet menu repair: forget any installed update and run the version that came with this sheet. */
function menuUseBuiltIn() {
  const ui = SpreadsheetApp.getUi();
  const r = ui.alert('Use the built-in version',
    'This removes any update installed from the LearnerBot site and goes back to the version that came with this sheet. Your goals, key and token are not touched, and you can update again from the site any time. Continue?',
    ui.ButtonSet.OK_CANCEL);
  if (r !== ui.Button.OK) return;
  _lbClear();
  ui.alert('Done. Reload this sheet, then reload LearnerBot.');
}

// ---- the app that came with this copy --------------------------

function _lbBuiltin() {
// ============================================================
// Agents.js
// ============================================================
// ============================================================
// Agents.gs \u2014 the four AI agents
// ============================================================

// ---- Context helpers ---------------------------------------

const CTX_MAX_GOALS = 25;       // keeps a prompt small however long the lists grow
const CTX_TASKS_PER_GOAL = 5;
const CTX_LOG_ENTRIES = 5;
const CTX_LOG_CHARS = 200;

function _fmtMinutes(m) {
  if (!m) return '';
  const h = Math.floor(m / 60), r = m % 60;
  return (h ? h + 'h' : '') + (h && r ? ' ' : '') + (r ? r + 'm' : '');
}

/** "Thursday 2026-10-15": the model has no clock, so every prompt that talks about dates states today. */
function _todayLine() {
  return Utilities.formatDate(new Date(), _tzName(), 'EEEE') + ' ' + _today();
}

function _dueText(due) {
  if (!due) return '';
  const n = _daysUntil(due);
  if (n == null) return '';
  if (n < 0) return 'OVERDUE by ' + (-n) + ' day' + (n === -1 ? '' : 's') + ' (was due ' + due + ')';
  if (n === 0) return 'due TODAY';
  if (n === 1) return 'due tomorrow';
  return 'due ' + due + ' (' + n + ' days left)';
}

/** Goal title with priority, tags and deadline: the one-line form used in every prompt. */
function _goalLine(g) {
  const due = _dueText(g.due);
  return `[${g.priority}] ${g.title}${g.tags.length ? ' [' + g.tags.join(', ') + ']' : ''}${due ? ' \u2014 ' + due : ''}`;
}

function _logLine(j) {
  const mins = _fmtMinutes(j.minutes);
  return `- ${j.date}${mins ? ' (' + mins + ')' : ''}: ${j.text.slice(0, CTX_LOG_CHARS)}${j.tags.length ? ' [' + j.tags.join(', ') + ']' : ''}`;
}

/**
 * The user's chosen coach voice, as extra system-prompt lines. Their words are passed on exactly as
 * written. `scope` says which parts of the answer the voice applies to.
 */
function _voiceBlock(scope) {
  let v = '';
  try { v = getCoachVoice(); } catch (_) { /* a voice is optional; never block the coach over it */ }
  if (!v) return [];
  return [
    '',
    'COACH VOICE. The user chose how you should sound, in their own words below. Follow it for the tone, style and attitude of ' + (scope || 'everything you write') + '.',
    'It never changes the JSON shape or the key names, and it never lets you invent progress, events or facts: stay truthful to the data you were given.',
    'Keep the answer valid JSON whatever the voice: plain text inside the strings, escape any double quote, and never put a raw line break inside a string.',
    '"""',
    v,
    '"""'
  ];
}

// ---- Context builders --------------------------------------

function buildDailyContext() {
  const goals    = getActiveGoals().slice(0, CTX_MAX_GOALS);
  const feedback = getRecentFeedback(3);
  const journal  = getRecentJournal(30);
  const recent   = journal.slice(-CTX_LOG_ENTRIES);
  const today    = _today();

  const openTasks = {};
  getAllTasks().filter(t => t.status === 'active').forEach(t => { (openTasks[t.goalId] = openTasks[t.goalId] || []).push(t.title); });

  // Journal entries carry tags, not goal ids, so "how long since this goal saw any activity" is
  // read from entries that share one of the goal's tags (only for goals that have tags).
  const lastLogged = tag => journal.filter(j => j.tags.indexOf(tag) >= 0).reduce((m, j) => (j.date > m ? j.date : m), '');

  const lines = goals.map(g => {
    const age = _daysUntil(g.created);
    const facts = [age != null && age < 0 ? 'started ' + (-age) + ' day' + (age === -1 ? '' : 's') + ' ago' : (age === 0 ? 'started today' : '')];
    if (g.tags.length) {
      const last = g.tags.map(lastLogged).reduce((m, d) => (d > m ? d : m), '');
      facts.push(last ? 'last logged under its tags ' + last : 'nothing logged under its tags in 30 days');
    }
    const open = openTasks[g.id] || [];
    facts.push(open.length ? open.length + ' open task' + (open.length === 1 ? '' : 's') + ': ' + open.slice(0, CTX_TASKS_PER_GOAL).join('; ') + (open.length > CTX_TASKS_PER_GOAL ? '; \u2026' : '') : 'no open tasks');
    return '- ' + _goalLine(g) + '\n    ' + facts.filter(Boolean).join(' \u00b7 ');
  });

  let previous = '';
  try { const d = getLatestReport('daily'); if (d && d.data && d.data.focus) previous = d.data.focus + ' (' + _day(d.date).slice(0, 10) + ')'; } catch (_) { /* optional */ }

  return [
    'TODAY: ' + _todayLine(),
    '',
    'ACTIVE GOALS (with their age, deadline, open tasks and recent activity):',
    lines.length ? lines.join('\n') : '(none)',
    '',
    'RECENT LOG (oldest first; time is shown when the user recorded it):',
    recent.length ? recent.map(_logLine).join('\n') : '(nothing logged in the last 30 days)',
    '',
    'PREVIOUS DAILY FOCUS: ' + (previous || '(none)'),
    '',
    'RECENT FEEDBACK FROM YOU:',
    feedback.length ? feedback.map(f => `- ${f.text}`).join('\n') : '(none)'
  ].join('\n');
}

function buildWeeklyContext() {
  const journal  = getRecentJournal(7);
  const feedback = getRecentFeedback(5);
  const history  = getRecentHistory(3);
  const goals    = getActiveGoals().slice(0, CTX_MAX_GOALS);
  const total    = journal.reduce((s, j) => s + j.minutes, 0);
  return [
    'TODAY: ' + _todayLine(),
    '',
    'ACTIVE GOALS:',
    goals.length ? goals.map(g => '- ' + _goalLine(g)).join('\n') : '(none)',
    '',
    'THIS WEEK\'S ACTIVITY LOG:',
    journal.length
      ? journal.map(_logLine).join('\n')
      : '(nothing logged \u2014 base review on goals alone)',
    total ? 'TIME RECORDED THIS WEEK: ' + _fmtMinutes(total) + ' (only entries where the user chose to record time)' : '',
    '',
    'RECENT WEEKLY SCORES:',
    history.length ? history.map(h => `- Week of ${h.week}: ${h.score}/10`).join('\n') : '(no history yet)',
    '',
    'YOUR FEEDBACK TO ME:',
    feedback.length ? feedback.map(f => `- ${f.text}`).join('\n') : '(none)'
  ].filter((l, i, a) => l !== '' || a[i - 1] !== '').join('\n');
}

function buildPlanContext(dashboard) {
  const goals = getActiveGoals().slice(0, CTX_MAX_GOALS);
  return [
    'TODAY: ' + _todayLine(),
    '',
    'THIS WEEK\'S REVIEW:',
    JSON.stringify(dashboard),
    '',
    'CURRENT ACTIVE GOALS:',
    goals.length ? goals.map(g => '- ' + _goalLine(g)).join('\n') : '(none)'
  ].join('\n');
}

// ---- Agent calls -------------------------------------------

function callLearningCoach(context) {
  return callGroq([
    {
      role: 'system',
      content: [
        'You are a Learning Coach for a single user checking in each morning.',
        'Given their active goals and any feedback, choose ONE specific focus for today.',
        'Be concrete \u2014 name the goal, the action, the reason. Do not be generic.',
        'Weigh what the facts say: overdue and soon-due goals first, then goals that have gone quiet, then goals that already have open tasks you can point at.',
        'Build on what they have actually logged lately, and do not simply repeat the previous focus unless a deadline demands it.',
        'Suggest actions that fit a single day. Only mention a deadline, age or time if it is in the data.',
        '',
        'Return ONLY valid JSON in exactly this shape (no markdown, no extra keys):',
        '{"focus":"short title for today","actions":["specific action 1","specific action 2","specific action 3"],"reason":"one sentence on why this focus matters today"}'
      ].concat(_voiceBlock()).join('\n')
    },
    { role: 'user', content: context }
  ]);
}

function callLifeDashboard(context) {
  return callGroq([
    {
      role: 'system',
      content: [
        'You are a Life Dashboard agent giving an honest weekly review.',
        'Treat the user as a capable peer. Be specific \u2014 cite what they actually logged, not platitudes.',
        'Mention deadlines that were met, are coming up or were missed, and use recorded time only if it is given.',
        'wins must have at least 1 item. suggestions must have at least 2 items.',
        '',
        'Return ONLY valid JSON in exactly this shape (no markdown, no extra keys):',
        '{"summary":"2-3 sentence narrative of the week","wins":["concrete win 1","concrete win 2"],"misses":["what slipped"],"suggestions":["specific adjustment 1","specific adjustment 2"]}'
      ].concat(_voiceBlock()).join('\n')
    },
    { role: 'user', content: context }
  ]);
}

function callGoalArchitect(context) {
  return callGroq([
    {
      role: 'system',
      content: [
        'You are a Goal Architect. Given a weekly review, propose a realistic plan for next week.',
        'Do not overwhelm. Build on existing goals where possible, and plan around any deadlines.',
        'goals must have 1\u20133 items. priorities must have at least 2 items.',
        '',
        'Return ONLY valid JSON in exactly this shape (no markdown, no extra keys):',
        '{"goals":[{"title":"goal title","priority":"high|medium|low","rationale":"one line why"}],"priorities":["action priority 1","action priority 2"],"focus_areas":["theme 1"]}'
      ].concat(_voiceBlock()).join('\n')
    },
    { role: 'user', content: context }
  ]);
}

function callConcierge(context) {
  return callGroq([
    {
      role: 'system',
      content: [
        'You are the concierge for a personal life-dashboard. Translate the user\'s message into one structured action.',
        '',
        'Available actions: add_goal, complete_goal, postpone_goal, remove_goal, update_goal, add_task, complete_task, add_feedback, log_activity, run_daily, run_weekly, none',
        '- add_goal: set title, priority if implied, tags if mentioned (comma-separated uppercase), due if they give a deadline, parent_id if they say "sub-goal of" or "under [goal]" (match goal ID from list)',
        '- complete_goal / postpone_goal / remove_goal: set goal_id by matching their words to the goal list',
        '- update_goal: set goal_id, then ONLY the fields they want changed: title (rename), priority, tags, due. To remove a deadline set due to "none".',
        '- add_task: set goal_id by matching their words, and title for the task',
        '- complete_task: set task_id by matching their words to the task list',
        '- add_feedback: user guiding how agents should behave \u2192 put in text',
        '- log_activity: user reporting what they did \u2192 put in text; extract tags if mentioned; set minutes only if they say how long (whole minutes, nearest 15)',
        '- run_daily / run_weekly: user asks for a fresh check-in or review',
        '- none: small talk or question \u2014 answer directly in reply',
        '',
        'due is a date written yyyy-mm-dd. Work out relative dates ("by Friday", "next week", "end of the month") from TODAY in the message. Leave due null unless they state or clearly imply a deadline.',
        'Always set reply: a friendly one-line confirmation or direct answer.',
        'If you cannot match a goal_id or task_id confidently, use none and ask which one in reply.',
        '',
        'Return ONLY valid JSON (no markdown):',
        '{"action":"...","title":null,"goal_id":null,"task_id":null,"parent_id":null,"priority":null,"tags":null,"due":null,"minutes":null,"text":null,"reply":"..."}'
      ].concat(_voiceBlock('the reply field only. Keep every other field plain and literal')).join('\n')
    },
    { role: 'user', content: context }
  ]);
}

// ============================================================
// Api.js
// ============================================================
// ============================================================
// Api.js \u2014 the JSON API the static site talks to
//
// POST  body (text/plain, to avoid a CORS preflight):
//       {"token": "...", "action": "getState", "args": {...}, "tz": "America/Denver"}
// reply {"ok": true, "data": ...}  or  {"ok": false, "code": "...", "error": "..."}
// GET   returns a harmless health check, never any data.
// ============================================================

function doGet() {
  return _json({ ok: true, data: { app: 'LearnerBot', release: APP_RELEASE, version: APP_VERSION } });
}

function doPost(e) {
  const t0 = Date.now();
  Object.keys(_prof).forEach(k => delete _prof[k]);
  const marks = {};
  const ms = () => Object.assign({ total: Date.now() - t0 }, marks, _prof);
  let req;
  try {
    req = JSON.parse((e && e.postData && e.postData.contents) || '{}');
  } catch (_) {
    return _json({ ok: false, code: 'bad_request', error: 'Request body was not valid JSON.', ms: ms() });
  }
  try {
    // A public action (redeeming a pairing code) has no token yet, so it must not touch anything a
    // caller could abuse without one: no time zone change, no sheet set-up.
    const isPublic = typeof req.action === 'string' && PUBLIC_ACTIONS.indexOf(req.action) >= 0;
    if (!isPublic) {
      _authorize(req.token);
      marks.auth = Date.now() - t0;
      _useTimeZone(req.tz);
    }
    const fn = Object.prototype.hasOwnProperty.call(ACTIONS, req.action) ? ACTIONS[req.action] : null;
    if (!fn) throw _err('bad_action', 'Unknown action.');
    if (!isPublic) _ensureHeaders();
    marks.ready = Date.now() - t0;
    const data = fn(req.args || {});
    return _json({ ok: true, data: data, ms: ms() });
  } catch (err) {
    return _json({ ok: false, code: (err && err.code) || 'error', error: String((err && err.message) || err), ms: ms() });
  }
}

const ACTIONS = {
  ping: () => ({ release: APP_RELEASE, version: APP_VERSION, hasKey: _hasKey(), tz: _tzName(), role: _role }),
  getState: () => getState(),

  // Small changes answer with just what the page needs (the page already updated itself),
  // not a re-read of every tab. AI actions below still return the full state.
  addGoal: a => ({ goal: addGoal(a.title, a.priority, a.tags, a.parentId, a.due) }),
  updateGoal: a => ({ goal: updateGoal(a.id, a.fields) }),
  setGoalStatus: a => {
    if (!setGoalStatus(a.id, a.status)) throw _err('not_found', 'Goal not found.');
    return { ok: true };
  },
  addTask: a => ({ task: addTask(a.goalId, a.title) }),
  setTaskStatus: a => {
    if (!setTaskStatus(a.id, a.status)) throw _err('not_found', 'Task not found.');
    return { ok: true };
  },
  logActivity: a => {
    addJournalEntry(a.text, a.tags, a.minutes);
    return { streak: getStreak(), weekMinutes: weekMinutes() };
  },
  submitFeedback: a => {
    addFeedback(a.text);
    return { ok: true };
  },
  saveCoachVoice: a => ({ coachVoice: setCoachVoice(a.text) }),
  saveAppearance: a => ({ appearance: setAppearance(a) }),

  saveNotifications: a => saveNotifications(a),
  sendTestEmail:     () => sendTestEmail(),

  // Phone pairing (Pairing.js). Everything but redeemPairing is master-only.
  createPairing:     () => createPairing(),
  redeemPairing:     a => redeemPairing(a || {}),
  emailPairingLink:  a => emailPairingLink(a),
  listDevices:       () => listDevices(),
  revokeDevice:      a => revokeDevice(a),
  revokeAllDevices:  () => revokeAllDevices(),

  runDaily:  () => runDailyNow(),
  runWeekly: () => runWeeklyNow(),
  chat:      a => chat(a.message)
};

/** Everything the dashboard needs, in one response. Each section fails on its own. */
function getState() {
  const errs = [];
  const safe = (label, fn, fallback) => {
    try { return fn(); }
    catch (e) { errs.push(label + ': ' + e.message); return fallback; }
  };
  return {
    goals:          safe('goals',    getAllGoals,                      []),
    tasks:          safe('tasks',    getAllTasks,                      []),
    historyGoals:   safe('hist',     getHistoryGoals,                  []),
    dailyReport:    safe('daily',    () => getLatestReport('daily'),   null),
    weeklyReport:   safe('weekly',   () => getLatestReport('weekly'),  null),
    recentFeedback: safe('feedback', () => getRecentFeedback(3),       []),
    history:        safe('history',  () => getRecentHistory(5),        []),
    chatHistory:    safe('chat',     () => getChatHistory(30),         []),
    streak:         safe('streak',   getStreak,                        0),
    weekMinutes:    safe('minutes',  weekMinutes,                      0),
    coachVoice:     safe('voice',    getCoachVoice,                    ''),
    appearance:     safe('look',     getAppearance,                    null),
    notify:         safe('notify',   _notifyView,                      null),
    role:           _role,
    hasKey:         _hasKey(),
    release:        APP_RELEASE,
    version:        APP_VERSION,
    // Which copy of the app is running and whether the site can update it (the loader answers; null when there is none).
    appInfo:        safe('app',      () => (typeof lbInfo === 'function' ? lbInfo() : null), null),
    _errors:        errs
  };
}

// ---- Plumbing -----------------------------------------------

function _err(code, message) {
  const e = new Error(message);
  e.code = code;
  return e;
}

function _json(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}

function _authorize(token) {
  const expected = _props().getProperty('API_TOKEN');
  if (!expected) throw _err('not_configured', 'This backend is not set up yet. In the sheet, open LearnerBot \u2192 Show connection info.');
  if (token === expected) { _role = 'master'; return; }
  const device = _deviceForToken(token);
  if (!device) throw _err('unauthorized', 'Wrong access token.');
  _role = 'device';
  _touchDevice(device);
}

function _useTimeZone(tz) {
  if (typeof tz !== 'string' || !tz) return;
  try { Utilities.formatDate(new Date(), tz, 'yyyy'); } catch (_) { return; }
  _tz = tz;
  if (_props().getProperty('TZ') !== tz) _props().setProperty('TZ', tz);
}

// Keyed by version, so a newly pasted update adds its new columns on the very next request
// instead of waiting for an old "already done" marker to expire.
function _ensureHeaders() {
  const cache = CacheService.getScriptCache();
  const key = 'h_ok_' + APP_VERSION;
  if (cache.get(key)) return;
  initHeaders();
  cache.put(key, '1', 3600);
}

