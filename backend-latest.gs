    '<script>function cp(id){var e=document.getElementById(id);e.select();document.execCommand("copy");}</script>';
  SpreadsheetApp.getUi().showModalDialog(HtmlService.createHtmlOutput(html).setWidth(540).setHeight(430), 'LearnerBot connection');
}

function menuResetToken() {
  const ui = SpreadsheetApp.getUi();
  const r = ui.alert('Reset access token', 'Everything using the old token stops working until you paste the new one, and every connected phone is disconnected. Continue?', ui.ButtonSet.OK_CANCEL);
  if (r !== ui.Button.OK) return;
  _props().deleteProperty('API_TOKEN');
  _props().deleteProperty('DEVICES');   // phones hold their own tokens; a reset must cut them off too
  _ensureToken();
  ui.alert('Done. Open LearnerBot \u2192 Show connection info for the new token, and pair your phones again.');
}

// Email settings, triggers and the scheduled jobs live in Notify.js.

// ---- AI flows -----------------------------------------------

/** One coaching run: asks the model and saves the report. Used by the app and by the scheduled job. */
function generateDaily() {
  _throttleAi();
  const result = callLearningCoach(buildDailyContext());
  saveReport('daily', result);
  return result;
}

function runDailyNow() {
  generateDaily();
  return getState();
}

/** One weekly review + plan: saves the report and a history row. */
function generateWeekly() {
  _throttleAi();
  const dash  = callLifeDashboard(buildWeeklyContext());
  const plan  = callGoalArchitect(buildPlanContext(dash));
  const goals = getAllGoals();
  const done  = goals.filter(g => g.status === 'completed').length;
  const score = goals.length > 0 ? Math.round((done / goals.length) * 10) : 0;
  saveReport('weekly', { dashboard: dash, plan: plan, score: score });
  addHistoryEntry(score, dash.summary || '');
  return { dashboard: dash, score: score };
}

function runWeeklyNow() {
  generateWeekly();
  return getState();
}

function chat(message) {
  const text = _clip(message, LIMITS.message);
  if (!text) throw _err('bad_request', 'Say something first.');
  _throttleAi();
  const goals    = getAllGoals();
  const tasks    = getAllTasks();
  const goalList = goals.map(g => `[#${g.id}] ${g.title} (${g.priority}, ${g.status})${g.tags.length ? ' [' + g.tags.join(', ') + ']' : ''}${g.parentId ? ' parent:' + g.parentId : ''}${g.due ? ' due:' + g.due : ''}`).join('\n');
  const taskList = tasks.filter(t => t.status === 'active').map(t => `[task#${t.id} \u2192 goal#${t.goalId}] ${t.title}`).join('\n');
  const ctx = `TODAY: ${_todayLine()}\n\nUSER MESSAGE:\n${text}\n\nCURRENT GOALS:\n${goalList || '(none)'}\n\nACTIVE TASKS:\n${taskList || '(none)'}`;
  saveChatMessage('user', text);
  const intent = callConcierge(ctx);
  const reply = applyIntent(intent);
  saveChatMessage('bot', reply);
  return { reply: reply, state: getState() };
}

/** Applies one structured action chosen by the concierge model. */
function applyIntent(intent) {
  try {
    switch (intent.action) {
      case 'add_goal':
        // A date the model got wrong is dropped rather than failing the whole request.
        if (intent.title) addGoal(intent.title, intent.priority, intent.tags, intent.parent_id, _safeDue(intent.due));
        break;
      case 'complete_goal':
        if (intent.goal_id) setGoalStatus(intent.goal_id, 'completed');
        break;
      case 'postpone_goal':
        if (intent.goal_id) setGoalStatus(intent.goal_id, 'postponed');
        break;
      case 'remove_goal':
        if (intent.goal_id) setGoalStatus(intent.goal_id, 'archived');
        break;
      case 'update_goal': {
        if (!intent.goal_id) break;
        const f = {};
        if (intent.title) f.title = intent.title;
        if (PRIORITIES.indexOf(intent.priority) >= 0) f.priority = intent.priority;
        if (intent.tags) f.tags = intent.tags;
        if (intent.due) {
          if (String(intent.due).trim().toLowerCase() === 'none') f.due = '';
          else { const d = _safeDue(intent.due); if (d) f.due = d; }
        }
        if (Object.keys(f).length) updateGoal(intent.goal_id, f);
        break;
      }
      case 'add_task':
        if (intent.goal_id && intent.title) addTask(intent.goal_id, intent.title);
        break;
      case 'complete_task':
        if (intent.task_id) setTaskStatus(intent.task_id, 'done');
        break;
      case 'add_feedback':
        if (intent.text) addFeedback(intent.text);
        break;
      case 'log_activity':
        if (intent.text) addJournalEntry(intent.text, intent.tags, _safeMinutes(intent.minutes));
        break;
      case 'run_daily':
        runDailyNow();
        break;
      case 'run_weekly':
        runWeeklyNow();
        break;
    }
    return String(intent.reply || 'Done.');
  } catch (e) {
    return 'Sorry, I could not do that: ' + (e && e.message ? e.message : e);
  }
}

// ---- HTML escaping (used by the connection window and the emails) ----

function _h(s) {
  return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

// ============================================================
// Groq.js
// ============================================================
// ============================================================
// Groq.gs \u2014 Groq API wrapper
// ============================================================

const GROQ_ATTEMPTS = 3;

/**
 * Call the Groq chat completion endpoint and return the parsed JSON answer.
 *
 * Groq's JSON mode fails now and then on its own: it answers HTTP 400 "json_validate_failed", or the
 * model runs out of room and the JSON is cut off, or the answer is empty. None of that is the
 * user's fault, so those cases are retried (up to GROQ_ATTEMPTS tries) before anything is shown.
 * Problems retrying cannot fix (a rejected key, a bad request) fail at once with a plain message.
 */
function callGroq(messages) {
  const key = getApiKey();

  const payload = JSON.stringify({
    model: GROQ_MODEL,
    messages: messages,
    response_format: { type: 'json_object' },
    temperature: 0.4,
    // The model's own "thinking" counts against this, so too small a number cuts the JSON off.
    max_tokens: 2048
  });

  const options = {
    method: 'post',
    headers: {
      'Authorization': 'Bearer ' + key,
      'Content-Type':  'application/json'
    },
    payload: payload,
    muteHttpExceptions: true
  };

  let why = '';
  for (let attempt = 1; attempt <= GROQ_ATTEMPTS; attempt++) {
    const resp = UrlFetchApp.fetch('https://api.groq.com/openai/v1/chat/completions', options);
    const code = resp.getResponseCode();
    const text = resp.getContentText();

    if (code === 429) {                       // rate limited: wait a moment and try again
      why = 'Groq is rate limiting this key right now. Wait a minute and try again.';
      if (attempt < GROQ_ATTEMPTS) Utilities.sleep(3000);
      continue;
    }
    if (code === 401 || code === 403) {
      throw _err('bad_key', 'Groq did not accept your API key. In the sheet, open LearnerBot \u2192 Set Groq API key and paste it again.');
    }
    if (code >= 500) {                        // Groq hiccup
      why = 'Groq had a temporary problem (' + code + '). Try again in a moment.';
      if (attempt < GROQ_ATTEMPTS) Utilities.sleep(1500);
      continue;
    }
    if (code === 400 && /json_validate_failed/.test(text)) {   // the model produced JSON Groq could not accept
      why = 'The AI answered in a format the app could not read.';
      Logger.log('Attempt ' + attempt + ': json_validate_failed');
      continue;
    }
    if (code !== 200) {
      throw new Error('Groq API returned ' + code + ': ' + text.slice(0, 300));
    }

    let content = '';
    try {
      const choice = JSON.parse(text).choices[0];
      content = (choice.message && choice.message.content) || '';
      if (choice.finish_reason === 'length') Logger.log('Attempt ' + attempt + ': answer was cut off (max_tokens)');
    } catch (_) { /* treated as an unreadable answer below */ }

    try {
      const parsed = JSON.parse(content);
      if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) return parsed;
      throw new Error('not an object');
    } catch (parseErr) {
      why = 'The AI answered in a format the app could not read.';
      Logger.log('Attempt ' + attempt + ' parse failed: ' + String(content).slice(0, 200));
    }
  }

  throw _err('ai_failed', why + ' It was tried ' + GROQ_ATTEMPTS + ' times; nothing was changed. Please try again.');
}

// ============================================================
// Notify.js
// ============================================================
// ============================================================
// Notify.js \u2014 email settings, scheduled jobs, test email
//
// Settings live in Script Properties. Like the time triggers they drive, they stay with this
// script and do not travel when the sheet is copied, so a copy never claims emails are on
// with nothing scheduled.
//
// Only the scheduled jobs send email. Pressing Run daily / Run weekly in the app never does.
// Mail only ever goes to the Google account that owns this script.
// ============================================================

const NOTIFY_DEFAULTS = {
  daily:  { enabled: false, hour: 7 },
  weekly: { enabled: false, day: 0, hour: 18 },   // day: 0 = Sunday ... 6 = Saturday
  nudge:  { enabled: false, hour: 20 }
};
const WEEKDAYS = ['SUNDAY', 'MONDAY', 'TUESDAY', 'WEDNESDAY', 'THURSDAY', 'FRIDAY', 'SATURDAY'];
const JOB_HANDLERS = ['_dailyJob', '_weeklyJob', '_nudgeJob'];
const TEST_EMAILS_PER_HOUR = 5;

// ---- Settings -----------------------------------------------

function _notifySettings() {
  let saved = {};
  try { saved = JSON.parse(_props().getProperty('NOTIFY') || '{}') || {}; } catch (_) { saved = {}; }
  const pick = k => Object.assign({}, NOTIFY_DEFAULTS[k], saved[k] || {});
  return { daily: pick('daily'), weekly: pick('weekly'), nudge: pick('nudge'), siteUrl: typeof saved.siteUrl === 'string' ? saved.siteUrl : '' };
}

function _int(v, min, max, label) {
  const n = Number(v);
  if (v === '' || v === null || !Number.isInteger(n) || n < min || n > max) {
    throw _err('bad_request', label + ' must be a whole number from ' + min + ' to ' + max + '.');
  }
  return n;
}

function _cleanNotify(a) {
  const d = a.daily || {}, w = a.weekly || {}, n = a.nudge || {};
  const out = {
    daily:  { enabled: d.enabled === true, hour: _int(d.hour, 0, 23, 'The daily hour') },
    weekly: { enabled: w.enabled === true, day: _int(w.day, 0, 6, 'The weekly day'), hour: _int(w.hour, 0, 23, 'The weekly hour') },
    nudge:  { enabled: n.enabled === true, hour: _int(n.hour, 0, 23, 'The nudge hour') },
    siteUrl: ''
  };
  // The link emails point back to: https only, no spaces or quote characters.
  const url = String(a.siteUrl || '').trim().slice(0, 300);
  if (/^https:\/\/[A-Za-z0-9.-]+(:\d+)?(\/[^\s"'<>]*)?$/.test(url)) out.siteUrl = url;
  return out;
}

function _ownerEmail() {
  try { return Session.getEffectiveUser().getEmail() || ''; } catch (_) { return ''; }
}

/** What the page shows: the saved choices plus where mail goes and which time zone the hours use. */
function _notifyView() {
  return Object.assign(_notifySettings(), { email: _ownerEmail(), tz: _tzName() });
}

function saveNotifications(a) {
  const s = _cleanNotify(a || {});
  _props().setProperty('NOTIFY', JSON.stringify(s));
  _syncTriggers(s);
  return { notify: _notifyView() };
}

// ---- Triggers (one per switched-on schedule) ----------------

function _syncTriggers(s) {
  ScriptApp.getProjectTriggers()
    .filter(t => JOB_HANDLERS.indexOf(t.getHandlerFunction()) >= 0)
    .forEach(t => ScriptApp.deleteTrigger(t));
  const tz = _tzName();
  // atHour runs within about 15 minutes of the hour; Apps Script cannot be more exact.
  if (s.daily.enabled)  ScriptApp.newTrigger('_dailyJob').timeBased().inTimezone(tz).atHour(s.daily.hour).everyDays(1).create();
  if (s.weekly.enabled) ScriptApp.newTrigger('_weeklyJob').timeBased().inTimezone(tz).onWeekDay(ScriptApp.WeekDay[WEEKDAYS[s.weekly.day]]).atHour(s.weekly.hour).create();
  if (s.nudge.enabled)  ScriptApp.newTrigger('_nudgeJob').timeBased().inTimezone(tz).atHour(s.nudge.hour).everyDays(1).create();
}

/** Sheet-menu panic button: every schedule off, hours remembered. */
function menuEmailsOff() {
  const s = _notifySettings();
  ['daily', 'weekly', 'nudge'].forEach(k => { s[k].enabled = false; });
  _props().setProperty('NOTIFY', JSON.stringify(s));
  _syncTriggers(s);
  SpreadsheetApp.getUi().alert('All scheduled emails are off and nothing runs on a schedule now. You can turn them back on in the LearnerBot site: \u2699 \u2192 Email updates.');
}

// ---- Scheduled jobs -----------------------------------------

function _dailyJob() {
  _runJob('daily', () => {
    const r = generateDaily();
    _sendMail('Daily focus: ' + _oneLine(r.focus), _dailyHtml(r));
  });
}

function _weeklyJob() {
  _runJob('weekly', () => {
    const w = generateWeekly();
    _sendMail('Weekly review: ' + w.score + '/10', _weeklyHtml(w.score, w.dashboard));
  });
}

function _nudgeJob() {
  _runJob('nudge', () => {
    if (_loggedToday()) return;
    _sendMail('Quick check-in: nothing logged yet today', _nudgeHtml());
  });
}

/** A scheduled run must never throw: failures are recorded (Reports tab, type "error") and skipped. */
function _runJob(name, fn) {
  try {
    if (!_notifySettings()[name].enabled) return;   // switched off after the trigger was created
    fn();
  } catch (e) {
    _logJobError(name, e);
  }
}

function _logJobError(job, e) {
  const message = String((e && e.message) || e).slice(0, 300);
  try { saveReport('error', { job: job, message: message }); }
  catch (_) { Logger.log('Scheduled ' + job + ' job failed: ' + message); }
}

function _loggedToday() {
  const today = _today();
  return rows('Journal', JOURNAL_TAIL).some(r => r[1] && _day(r[0]).slice(0, 10) === today);
}

// ---- Test email ---------------------------------------------

function sendTestEmail() {
  const cache = CacheService.getScriptCache();
  const n = Number(cache.get('test_mail_count') || 0);
  if (n >= TEST_EMAILS_PER_HOUR) throw _err('rate_limited', 'Test emails are limited to ' + TEST_EMAILS_PER_HOUR + ' an hour.');
  cache.put('test_mail_count', String(n + 1), 3600);
  const to = _ownerEmail();
  if (!to) throw _err('no_email', 'Google did not give this script an address to send to.');
  _sendMail('LearnerBot test email', _testHtml());
  return { sent: true, to: to };
}

// ---- Sending and layout -------------------------------------

function _sendMail(subject, html) {
  const to = _ownerEmail();
  if (!to) throw _err('no_email', 'Google did not give this script an address to send to.');
  MailApp.sendEmail({ to: to, subject: subject, htmlBody: html });
}

function _oneLine(s) { return String(s == null ? '' : s).replace(/[\r\n]+/g, ' ').trim().slice(0, 120); }

function _footer() {
  const url = _notifySettings().siteUrl;
  return '<p style="font-family:sans-serif;color:#888;font-size:12px;margin-top:24px">' +
    (url ? '<a href="' + _h(url) + '">Open LearnerBot</a> \u00b7 ' : '') +
    'Change or stop these emails in LearnerBot: \u2699 \u2192 Email updates.</p>';
}

function _list(items) {
  return '<ul style="font-family:sans-serif">' + (items || []).map(x => '<li>' + _h(x) + '</li>').join('') + '</ul>';
}

function _dailyHtml(r) {
  return '<h2 style="font-family:sans-serif">Today\'s focus: ' + _h(r.focus) + '</h2>' + _list(r.actions) +
    '<p style="font-family:sans-serif;color:#666"><em>' + _h(r.reason) + '</em></p>' + _footer();
}

function _weeklyHtml(score, d) {
  d = d || {};
  return '<h2 style="font-family:sans-serif">Weekly score: ' + _h(score) + '/10</h2>' +
    '<p style="font-family:sans-serif">' + _h(d.summary) + '</p>' +
    ((d.wins || []).length ? '<h3 style="font-family:sans-serif">Wins</h3>' + _list(d.wins) : '') +
    ((d.suggestions || []).length ? '<h3 style="font-family:sans-serif">Suggestions</h3>' + _list(d.suggestions) : '') + _footer();
}

function _nudgeHtml() {
  return '<h2 style="font-family:sans-serif">Nothing logged yet today</h2>' +
    '<p style="font-family:sans-serif">A line is enough: what did you do or learn today? It keeps your streak and feeds your weekly review.</p>' + _footer();
}

function _testHtml() {
  return '<h2 style="font-family:sans-serif">It works</h2>' +
    '<p style="font-family:sans-serif">This is a test email from your LearnerBot. Scheduled emails will reach this address.</p>' + _footer();
}

// ============================================================
// Pairing.js
// ============================================================
// ============================================================
// Pairing.js \u2014 connect a phone without copying the long-lived token
//
// On the computer (the "master" connection) you create a one-time pairing link. Opening it on a
// phone swaps the one-time code for that phone's OWN device token. The master token never leaves
// the computer, and each phone can be revoked on its own.
//
//   * A code is ~120 random bits, lives 10 minutes and works once.
//   * Wrong codes are throttled: 10 failures lock redeeming for 10 minutes.
//   * Device tokens are stored only as SHA-256 hashes.
//   * Only the master connection can create links, email them, list or revoke devices.
//   * The pairing email goes only to the account that owns this script.
// ============================================================

const PAIR_TTL_SECONDS    = 600;
const PAIR_MAX_FAILS      = 10;
const PAIR_MAKE_PER_HOUR  = 10;
const PAIR_MAIL_PER_HOUR  = 5;
const MAX_DEVICES         = 10;
const DEVICE_USED_REFRESH_MS = 3600 * 1000;

/** Actions that work without a token. Everything else needs the master or a device token. */
const PUBLIC_ACTIONS = ['redeemPairing'];

// https://<site>/<path>#pair=<deployment id>.<code>
const PAIR_LINK_RE = /^https:\/\/[A-Za-z0-9.-]+(:\d+)?\/[A-Za-z0-9._~\/%+-]*#pair=(AKfycb[A-Za-z0-9_-]{40,200})\.([0-9a-f]{20,64})$/;

// Which kind of connection made this request: 'master', 'device' or null. Set by _authorize.
let _role = null;

function _needMaster() {
  if (_role !== 'master') throw _err('forbidden', 'Only your main connection (the computer you pasted the token into) can do that.');
}

// ---- Small helpers ------------------------------------------

function _sha256Hex(s) {
  return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, String(s))
    .map(b => ('0' + (b < 0 ? b + 256 : b).toString(16)).slice(-2)).join('');
}

/** 30 random hex characters per UUID (its fixed version and variant digits are dropped). */
function _randomHex(uuids) {
  let out = '';
  for (let i = 0; i < uuids; i++) {
    const h = Utilities.getUuid().replace(/-/g, '');
    out += h.slice(0, 12) + h.slice(13, 16) + h.slice(17);
  }
  return out;
}

function _rateLimit(key, max, message) {
  const cache = CacheService.getScriptCache();
  const n = Number(cache.get(key) || 0);
  if (n >= max) throw _err('rate_limited', message);
  cache.put(key, String(n + 1), 3600);
}

function _pairKey(code) { return 'pair_' + _sha256Hex(code); }

function _cleanDeviceName(n) {
  const s = String(n == null ? '' : n).replace(/[^A-Za-z0-9 ._,+-]/g, '').replace(/\s+/g, ' ').trim().slice(0, 40);
  return s || 'Phone';
}

// ---- Device list (Script Properties, hashes only) -----------

function _devices() {
  let list = [];
  try { list = JSON.parse(_props().getProperty('DEVICES') || '[]'); } catch (_) { list = []; }
  return Array.isArray(list) ? list.filter(d => d && d.id && d.hash) : [];
}

function _saveDevices(list) { _props().setProperty('DEVICES', JSON.stringify(list)); }

function _deviceView(d) { return { id: d.id, name: d.name, created: d.created, used: d.used || '' }; }

function _deviceForToken(token) {
  if (typeof token !== 'string' || token.length < 20 || token.length > 200) return null;
  const hash = _sha256Hex(token);
  return _devices().find(d => d.hash === hash) || null;
}

/** Remember when a phone was last used, at most once an hour (every write costs time). */
function _touchDevice(dev) {
  const last = dev.used ? Date.parse(dev.used) : 0;
  if (last && Date.now() - last < DEVICE_USED_REFRESH_MS) return;
  withLock(() => {
    const list = _devices();
    const d = list.find(x => x.id === dev.id);
    if (d) { d.used = new Date().toISOString(); _saveDevices(list); }
  });
}

// ---- Master-only actions ------------------------------------

function createPairing() {
  _needMaster();
  _rateLimit('pair_made', PAIR_MAKE_PER_HOUR, 'Too many pairing links this hour. Try again later.');
  const code = _randomHex(1);
  CacheService.getScriptCache().put(_pairKey(code), '1', PAIR_TTL_SECONDS);
  return { code: code, expiresInSeconds: PAIR_TTL_SECONDS };
}

function listDevices() {
  _needMaster();
  return { devices: _devices().map(_deviceView) };
}

function revokeDevice(a) {
  _needMaster();
  return withLock(() => {
    const list = _devices();
    const left = list.filter(d => d.id !== String(a && a.id));
    if (left.length === list.length) throw _err('not_found', 'That phone is not connected any more.');
    _saveDevices(left);
    return { devices: left.map(_deviceView) };
  });
}

function revokeAllDevices() {
  _needMaster();
  _props().deleteProperty('DEVICES');
  return { devices: [] };
}

function emailPairingLink(a) {
  _needMaster();
  const link = String((a && a.link) || '').trim();
  const m = link.length <= 400 ? PAIR_LINK_RE.exec(link) : null;
  if (!m || !CacheService.getScriptCache().get(_pairKey(m[3]))) {
    throw _err('bad_request', 'That is not a live pairing link. Create a new one first.');
  }
  _rateLimit('pair_mail', PAIR_MAIL_PER_HOUR, 'Pairing emails are limited to ' + PAIR_MAIL_PER_HOUR + ' an hour.');
  const to = _ownerEmail();
  if (!to) throw _err('no_email', 'Google did not give this script an address to send to.');
  _sendMail('Connect your phone to LearnerBot',
    '<h2 style="font-family:sans-serif">Connect your phone</h2>' +
    '<p style="font-family:sans-serif">Open this on your phone within 10 minutes. It works once.</p>' +
    '<p style="font-family:sans-serif"><a href="' + _h(link) + '" style="background:#6ea8fe;color:#08101f;padding:10px 16px;border-radius:8px;text-decoration:none;font-weight:bold">Connect this phone</a></p>' +
    '<p style="font-family:sans-serif;color:#888;font-size:12px">You asked for this from LearnerBot (\u2699 \u2192 Add your phone). If you did not, ignore it: the link expires by itself. Phones can be revoked there at any time.</p>');
  return { sent: true, to: to };
}

// ---- Public action: swap a one-time code for a device token ----

function redeemPairing(a) {
  if (!_props().getProperty('API_TOKEN')) throw _err('not_configured', 'This backend is not set up yet.');
  const cache = CacheService.getScriptCache();
  return withLock(() => {   // the lock makes "works once" hold even for two simultaneous requests
    const fails = Number(cache.get('pair_fail') || 0);
    if (fails >= PAIR_MAX_FAILS) {
      throw _err('rate_limited', 'Too many wrong attempts. Wait ten minutes, then create a new pairing link on your computer.');
    }
    const code = String((a && a.code) || '');
    const valid = /^[0-9a-f]{20,64}$/.test(code) && !!cache.get(_pairKey(code));
    if (!valid) {
      cache.put('pair_fail', String(fails + 1), 600);
      throw _err('bad_code', 'That pairing link has expired or was already used. On your computer, open \u2699 \u2192 Add your phone and create a new one.');
    }
    const list = _devices();
    if (list.length >= MAX_DEVICES) {
      throw _err('too_many_devices', 'This backend already has ' + MAX_DEVICES + ' connected phones. Revoke one on your computer, then try the same link again.');
    }
    cache.remove(_pairKey(code));
    const token = _randomHex(2);
    list.push({ id: _randomHex(1).slice(0, 12), name: _cleanDeviceName(a && a.name), hash: _sha256Hex(token), created: new Date().toISOString(), used: '' });
    _saveDevices(list);
    return { token: token };
  });
}

// ============================================================
// Sheets.js
// ============================================================
// ============================================================
// Sheets.js \u2014 all data access (read/write the spreadsheet)
//
// One spreadsheet per person. Reads are memoised for the length of a
// single request and every write invalidates the tab it touched, so a
// request opens the spreadsheet once and reads each tab at most once.
// Cells are written as plain text so Sheets never turns user text into
// a formula or a date.
// ============================================================

// New columns are only ever added at the end, and initHeaders() adds a missing header to an existing
// sheet, so older sheets pick them up on the first request after an update.
const TABS = {
  Goals:    ['ID', 'Title', 'Priority', 'Status', 'Created', 'Tags', 'ParentID', 'Due'],
  Journal:  ['Date', 'Text', 'Tags', 'Minutes'],
  Reports:  ['Date', 'Type', 'Data', 'Score'],
  Feedback: ['Date', 'Text'],
  History:  ['Week', 'Score', 'Summary'],
  Tasks:    ['ID', 'GoalID', 'Title', 'Status', 'Created'],
  Chat:     ['Timestamp', 'Role', 'Text'],
  Settings: ['Key', 'Value']
};

const PRIORITIES    = ['high', 'medium', 'low'];
const GOAL_STATUSES = ['active', 'completed', 'postponed', 'archived'];
const TASK_STATUSES = ['active', 'done', 'removed'];

// ---- Spreadsheet, tab and row access ------------------------

let _ssMemo = null;
const _sheetMemo = {};
const _rowsMemo = {};

// Where a request spends its time, in ms by label (open, tab, read, write, lock). It is sent back
// with every answer so the page can show server time next to total time.
const _prof = {};
function _timeIt(label, fn) {
  const t = Date.now();
  try { return fn(); } finally { _prof[label] = (_prof[label] || 0) + (Date.now() - t); }
}

function _ss() {
  if (_ssMemo) return _ssMemo;
  const id = _props().getProperty('SHEET_ID');
  _ssMemo = _timeIt('open', () => (id ? SpreadsheetApp.openById(id) : SpreadsheetApp.getActiveSpreadsheet()));
  if (!_ssMemo) throw _err('no_sheet', 'No spreadsheet found. Open the script from the sheet (Extensions \u2192 Apps Script) or set a SHEET_ID script property.');
  return _ssMemo;
}

function getSheet(name) {
  if (_sheetMemo[name]) return _sheetMemo[name];
  const ss = _ss();
  let sh = _timeIt('tab', () => ss.getSheetByName(name));
  if (!sh) sh = _createTab(ss, name);
  _sheetMemo[name] = sh;
  return sh;
}

function _createTab(ss, name) {
  const sh = ss.insertSheet(name);
  _writeHeader(sh, TABS[name]);
  return sh;
}

function _writeHeader(sh, cols) {
  sh.getRange(1, 1, 1, cols.length)
    .setNumberFormat('@').setValues([cols])
    .setFontWeight('bold').setBackground('#1a1a2e').setFontColor('#e6e9ef');
  sh.setFrozenRows(1);
}

/** Creates missing tabs and headers. Safe to run repeatedly (migrates missing columns). */
function initHeaders() {
  const ss = _ss();
  let created = 0;
  Object.keys(TABS).forEach(name => {
    const cols = TABS[name];
    const sh = ss.getSheetByName(name);
    if (!sh) { _createTab(ss, name); created++; return; }
    if (sh.getLastRow() === 0) { _writeHeader(sh, cols); return; }
    const existing = sh.getRange(1, 1, 1, Math.max(sh.getLastColumn(), 1)).getValues()[0];
    cols.forEach((col, i) => {
      if (!existing.includes(col)) {
        sh.getRange(1, i + 1).setValue(col)
          .setFontWeight('bold').setBackground('#1a1a2e').setFontColor('#e6e9ef');
      }
    });
  });
  // A brand-new spreadsheet starts with an empty "Sheet1"; drop it, but only when every one of our
  // tabs was just created. A sheet that already had data is never tidied this way.
  const blank = ss.getSheetByName('Sheet1');
  if (created === Object.keys(TABS).length && blank && blank.getLastRow() === 0 && ss.getSheets().length > 1) ss.deleteSheet(blank);
  Object.keys(_sheetMemo).forEach(k => delete _sheetMemo[k]);
  Object.keys(_rowsMemo).forEach(k => delete _rowsMemo[k]);
}

/** Data rows of a tab (header excluded). With `tail`, only the last `tail` rows. */
function rows(name, tail) {
  const key = name + '|' + (tail || 0);
  if (_rowsMemo[key]) return _rowsMemo[key];
  const sh = getSheet(name);
  const out = _timeIt('read', () => {
    const last = sh.getLastRow();
    const cols = sh.getLastColumn();
    if (last > 1 && cols > 0) {
      const start = tail ? Math.max(2, last - tail + 1) : 2;
      return sh.getRange(start, 1, last - start + 1, cols).getValues();
    }
    return [];
  });
  _rowsMemo[key] = out;
  return out;
}

function _invalidate(name) {
  Object.keys(_rowsMemo).forEach(k => { if (k.indexOf(name + '|') === 0) delete _rowsMemo[k]; });
}

function _appendRow(name, row) {
  const sh = getSheet(name);
  _timeIt('write', () => {
    const rng = sh.getRange(sh.getLastRow() + 1, 1, 1, row.length);
    rng.setNumberFormat('@');
    rng.setValues([row.map(v => typeof v === 'number' ? v : String(v == null ? '' : v))]);
  });
  _invalidate(name);
}

function _setCellById(name, id, col, value) {
  const i = rows(name).findIndex(r => String(r[0]) === String(id));
  if (i < 0) return false;
  const sh = getSheet(name);
  _timeIt('write', () => sh.getRange(i + 2, col).setValue(value));
  _invalidate(name);
  return true;
}

function _nextId(name) {
  const sh = getSheet(name);
  return _timeIt('read', () => {
    const last = sh.getLastRow();
    if (last < 2) return 1;
    return sh.getRange(2, 1, last - 1, 1).getValues()
      .reduce((m, r) => Math.max(m, parseInt(r[0], 10) || 0), 0) + 1;
  });
}

function withLock(fn) {
  const lock = LockService.getScriptLock();
  _timeIt('lock', () => lock.waitLock(20000));
  try { return fn(); } finally { lock.releaseLock(); }
}

// ---- Small helpers ------------------------------------------

function _parseTags(raw) {
  if (!raw) return [];
  return String(raw).split(',').map(t => t.trim().toUpperCase()).filter(Boolean);
}

function _tagString(tags) {
  return _clip(Array.isArray(tags) ? tags.join(',') : tags, LIMITS.tags).toUpperCase();
}

function _clip(v, max) { return String(v == null ? '' : v).trim().slice(0, max); }
function _priority(p)  { return PRIORITIES.indexOf(p) >= 0 ? p : 'medium'; }

const MAX_MINUTES = 1440;

/** '' (no deadline) or a real calendar date as yyyy-mm-dd. */
function _cleanDue(v) {
  const s = String(v == null ? '' : v).trim();
  if (!s) return '';
  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(s);
  const d = m ? new Date(Date.UTC(+m[1], +m[2] - 1, +m[3])) : null;
  if (!d || d.getUTCFullYear() !== +m[1] || d.getUTCMonth() !== +m[2] - 1 || d.getUTCDate() !== +m[3] || +m[1] < 2000 || +m[1] > 2100) {
    throw _err('bad_request', 'The due date must be a real date, year-month-day.');
  }
  return s;
}

/** '' (not recorded) or whole minutes from 1 to 1440. Zero means "not recorded". */
function _cleanMinutes(v) {
  if (v === '' || v == null) return '';
  // Only a number or digits in a string: Number() alone would also accept true, [30] and the like.
  const n = (typeof v === 'number' || (typeof v === 'string' && /^\s*\d+\s*$/.test(v))) ? Number(v) : NaN;
  if (!Number.isInteger(n) || n < 0 || n > MAX_MINUTES) throw _err('bad_request', 'Time must be a whole number of minutes, up to ' + MAX_MINUTES + '.');
  return n === 0 ? '' : n;
}

// A date or number the model supplied that turns out to be unusable is dropped, not an error.
function _safeDue(v)     { try { return _cleanDue(v); } catch (_) { return ''; } }
function _safeMinutes(v) { try { return _cleanMinutes(v); } catch (_) { return ''; } }

/** Whole days from today to a yyyy-mm-dd date (negative when past). */
function _daysUntil(ymd) {
  const a = /^(\d{4})-(\d{2})-(\d{2})$/.exec(_today()), b = /^(\d{4})-(\d{2})-(\d{2})$/.exec(ymd);
  if (!a || !b) return null;
  return Math.round((Date.UTC(+b[1], +b[2] - 1, +b[3]) - Date.UTC(+a[1], +a[2] - 1, +a[3])) / 864e5);
}

// Old rows may hold real Date cells (Sheets parses date-looking text); normalise on read.
function _day(v) { return v instanceof Date ? Utilities.formatDate(v, _tzName(), 'yyyy-MM-dd') : String(v == null ? '' : v); }
function _ts(v)  { return v instanceof Date ? v.toISOString() : String(v == null ? '' : v); }

function _today() { return Utilities.formatDate(new Date(), _tzName(), 'yyyy-MM-dd'); }

function _daysAgo(n) {
  const d = new Date();
  d.setDate(d.getDate() - n);
  return Utilities.formatDate(d, _tzName(), 'yyyy-MM-dd');
}

// ---- Goals --------------------------------------------------

function _goal(r) {
  return {
    id: String(r[0]), title: String(r[1]), priority: String(r[2]), status: String(r[3]),
    created: _day(r[4]), tags: _parseTags(r[5]), parentId: r[6] !== '' && r[6] != null ? String(r[6]) : '',
    due: r[7] !== '' && r[7] != null ? _day(r[7]).slice(0, 10) : ''
  };
}

function getAllGoals() {
  return rows('Goals').filter(r => r[0] !== '' && r[3] !== 'archived').map(_goal);
}

function getActiveGoals() {
  return getAllGoals().filter(g => g.status === 'active');
}

function getHistoryGoals() {
  return rows('Goals').filter(r => r[0] !== '' && r[3] !== 'active').map(_goal);
}

/** Adds a goal and returns it in the same shape getAllGoals() uses. `due` is optional (yyyy-mm-dd). */
function addGoal(title, priority, tags, parentId, due) {
  const t = _clip(title, LIMITS.title);
  if (!t) throw _err('bad_request', 'A goal needs a title.');
  const dueDay = _cleanDue(due);
  const parent = parentId ? String(parentId) : '';
  if (parent && !rows('Goals').some(r => String(r[0]) === parent)) throw _err('not_found', 'The parent goal does not exist.');
  return withLock(() => {
    const id = _nextId('Goals');
    const p = _priority(priority);
    const tagStr = _tagString(tags);
    const created = _today();
    _appendRow('Goals', [id, t, p, 'active', created, tagStr, parent, dueDay]);
    return { id: String(id), title: t, priority: p, status: 'active', created: created, tags: _parseTags(tagStr), parentId: parent, due: dueDay };
  });
}

/**
 * Changes the title, priority, tags and/or due date of a goal. Only the fields present in `f` change;
 * a due of '' clears the deadline. The whole row is rewritten in one call. Returns the goal.
 */
function updateGoal(id, f) {
  f = f || {};
  const has = k => Object.prototype.hasOwnProperty.call(f, k);
  const next = {};
  if (has('title')) { next.title = _clip(f.title, LIMITS.title); if (!next.title) throw _err('bad_request', 'A goal needs a title.'); }
  if (has('priority')) next.priority = _priority(f.priority);
  if (has('tags')) next.tags = _tagString(f.tags);
  if (has('due')) next.due = _cleanDue(f.due);
  return withLock(() => {
    const i = rows('Goals').findIndex(r => String(r[0]) === String(id));
    if (i < 0) throw _err('not_found', 'Goal not found.');
    const row = rows('Goals')[i].slice();
    while (row.length < TABS.Goals.length) row.push('');
    if ('title' in next)    row[1] = next.title;
    if ('priority' in next) row[2] = next.priority;
    if ('tags' in next)     row[5] = next.tags;
    if ('due' in next)      row[7] = next.due;
    const out = row.slice(0, TABS.Goals.length).map((v, c) => (c === 0 && typeof v === 'number') ? v : (v instanceof Date ? _day(v) : String(v == null ? '' : v)));
    _timeIt('write', () => {
      const rng = getSheet('Goals').getRange(i + 2, 1, 1, out.length);
      rng.setNumberFormat('@');
      rng.setValues([out]);
    });
    _invalidate('Goals');
    return _goal(out);
  });
}

function setGoalStatus(id, status) {
  if (GOAL_STATUSES.indexOf(status) < 0) throw _err('bad_request', 'Unknown goal status.');
  return _setCellById('Goals', id, 4, status);
}

// ---- Tasks --------------------------------------------------

function getAllTasks() {
  return rows('Tasks').filter(r => r[0] !== '' && r[3] !== 'removed')
    .map(r => ({ id: String(r[0]), goalId: String(r[1]), title: String(r[2]), status: String(r[3]), created: _day(r[4]) }));
}

function addTask(goalId, title) {
  const t = _clip(title, LIMITS.title);
  if (!t) throw _err('bad_request', 'A task needs a title.');
  if (!rows('Goals').some(r => String(r[0]) === String(goalId))) throw _err('not_found', 'That goal does not exist.');
  return withLock(() => {
    const id = _nextId('Tasks');
    const created = _today();
    _appendRow('Tasks', [id, String(goalId), t, 'active', created]);
    return { id: String(id), goalId: String(goalId), title: t, status: 'active', created: created };
  });
}

function setTaskStatus(id, status) {
  if (TASK_STATUSES.indexOf(status) < 0) throw _err('bad_request', 'Unknown task status.');
  return _setCellById('Tasks', id, 4, status);
}

// ---- Chat ---------------------------------------------------

function getChatHistory(n) {
  const count = n || 30;
  return rows('Chat', count).slice(-count).filter(r => r[1] && r[2])
    .map(r => ({ ts: _ts(r[0]), role: String(r[1]), text: String(r[2]) }));
}

function saveChatMessage(role, text) {
  withLock(() => _appendRow('Chat', [new Date().toISOString(), role, _clip(text, LIMITS.text)]));
}

// ---- Journal ------------------------------------------------

const JOURNAL_TAIL = 1500;

/** Logs an entry for today. `minutes` is optional (whole minutes; the page offers 15-minute steps). */
function addJournalEntry(text, tags, minutes) {
  const t = _clip(text, LIMITS.text);
  if (!t) throw _err('bad_request', 'Nothing to log.');
  const mins = _cleanMinutes(minutes);
  withLock(() => _appendRow('Journal', [_today(), t, _tagString(tags), mins]));
}

function _minutes(v) { const n = Number(v); return v !== '' && Number.isFinite(n) && n > 0 ? Math.min(Math.round(n), MAX_MINUTES) : 0; }

/** Entries from the last `days` days (0 minutes means none was recorded). */
function getRecentJournal(days) {
  const cutoff = _daysAgo(days || 7);
  return rows('Journal', JOURNAL_TAIL).filter(r => r[1] && _day(r[0]) >= cutoff)
    .map(r => ({ date: _day(r[0]), text: String(r[1]), tags: _parseTags(r[2]), minutes: _minutes(r[3]) }));
}

/** Total recorded minutes over the last 7 days, today included. */
function weekMinutes() {
  const cutoff = _daysAgo(6);
  return rows('Journal', JOURNAL_TAIL).filter(r => r[1] && _day(r[0]) >= cutoff)
    .reduce((sum, r) => sum + _minutes(r[3]), 0);
}

function getStreak() {
  const days = new Set(rows('Journal', JOURNAL_TAIL).filter(r => r[0]).map(r => _day(r[0]).slice(0, 10)));
  if (!days.size) return 0;
  // Not having logged yet today doesn't break a streak; yesterday still counts.
  const offset = days.has(_daysAgo(0)) ? 0 : 1;
  let streak = 0;
  while (streak < 365 && days.has(_daysAgo(offset + streak))) streak++;
  return streak;
}

// ---- Settings (small key/value pairs that live in the sheet, so they outlive a re-copied script) ----

function getSetting(key) {
  const r = rows('Settings').find(x => String(x[0]) === key);
  return r ? String(r[1] == null ? '' : r[1]) : '';
}

/** Stores the text exactly as given (no trimming of inner text); whitespace-only counts as empty. */
function setSetting(key, value, max) {
  let v = String(value == null ? '' : value).replace(/\r\n?/g, '\n').slice(0, max || LIMITS.text);
  if (!v.trim()) v = '';
  return withLock(() => {
    const i = rows('Settings').findIndex(x => String(x[0]) === key);
    if (i < 0) { _appendRow('Settings', [key, v]); return v; }
    _timeIt('write', () => {
      const rng = getSheet('Settings').getRange(i + 2, 2);
      rng.setNumberFormat('@');
      rng.setValue(v);
    });
    _invalidate('Settings');
    return v;
  });
}

/** The saved look ({theme, primary, accent, font}), or null when none has been saved or the saved text is not usable. */
function getAppearance() {
  const raw = getSetting('appearance');
  if (!raw) return null;
  try { return _cleanAppearance(JSON.parse(raw)); } catch (_) { return null; }
}

/**
 * Checks a look and returns it in canonical form; throws on anything unknown. A missing theme or font means
 * the default, and a blank accent means "the theme's own accent". `primary` is the page colour of the Custom
 * theme and `accent` the colour of buttons and highlights; each is blank or a #rrggbb colour.
 */
function _cleanAppearance(a) {
  if (!a || typeof a !== 'object' || Array.isArray(a)) throw _err('bad_request', 'That look is not valid.');
  const theme = a.theme == null || a.theme === '' ? 'dark' : a.theme;
  const font = a.font == null || a.font === '' ? 'system' : a.font;
  if (typeof theme !== 'string' || APPEARANCE_THEMES.indexOf(theme) < 0) throw _err('bad_request', 'Unknown theme.');
  if (typeof font !== 'string' || APPEARANCE_FONTS.indexOf(font) < 0) throw _err('bad_request', 'Unknown font.');
  const colour = (v, what) => {
    if (v == null || v === '') return '';
    if (typeof v !== 'string' || !/^#[0-9a-fA-F]{6}$/.test(v)) throw _err('bad_request', 'The ' + what + ' color must look like #6ea8fe.');
    return v.toLowerCase();
  };
  return { theme: theme, primary: colour(a.primary, 'primary'), accent: colour(a.accent, 'accent'), font: font };
}

function setAppearance(a) {
  const look = _cleanAppearance(a);
  setSetting('appearance', JSON.stringify(look), 200);
  return look;
}

function getCoachVoice()      { return getSetting('coach_voice'); }
function setCoachVoice(text)  { return setSetting('coach_voice', text, LIMITS.voice); }

// ---- Feedback -----------------------------------------------

function addFeedback(text) {
  const t = _clip(text, LIMITS.text);
  if (!t) throw _err('bad_request', 'Nothing to send.');
  withLock(() => _appendRow('Feedback', [_today(), t]));
}

function getRecentFeedback(n) {
  const count = n || 5;
  return rows('Feedback', count).slice(-count).filter(r => r[1])
    .map(r => ({ date: _day(r[0]), text: String(r[1]) }));
}

// ---- Reports ------------------------------------------------

function saveReport(type, data) {
  const score = (type === 'weekly' && data.score != null) ? data.score : '';
  withLock(() => _appendRow('Reports', [new Date().toISOString(), type, JSON.stringify(data), score]));
}

function getLatestReport(type) {
  const sh = getSheet('Reports');
  const last = sh.getLastRow();
  if (last < 2) return null;
  // Scan only the small Type column, then read the one matching row.
  const types = sh.getRange(2, 2, last - 1, 1).getValues();
  for (let i = types.length - 1; i >= 0; i--) {
    if (types[i][0] !== type) continue;
    const r = sh.getRange(i + 2, 1, 1, 4).getValues()[0];
    try { return { date: _ts(r[0]), type: String(r[1]), data: JSON.parse(r[2]), score: r[3] }; }
    catch (_) { /* unreadable row \u2014 keep looking */ }
  }
  return null;
}

// ---- History ------------------------------------------------

function addHistoryEntry(score, summary) {
  withLock(() => _appendRow('History', [_today(), score, _clip(summary, LIMITS.text)]));
}

function getRecentHistory(n) {
  const count = n || 5;
  return rows('History', count).slice(-count).filter(r => r[0])
    .map(r => ({ week: _day(r[0]), score: r[1] === '' ? null : Number(r[1]), summary: String(r[2]) }));
}

// ---- exports (the loader reads these) ----
return {
  doGet,
  doPost,
  onOpen,
  menuSetGroqKey,
  menuShowConnection,
  menuResetToken,
  menuEmailsOff,
  _dailyJob,
  _weeklyJob,
  _nudgeJob,
  version: APP_VERSION
};
}
